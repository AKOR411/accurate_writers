SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-project-publishable-key
# Server-only. Never expose this key through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Daraja M-PESA Express/STK Push (sandbox by default; configure Vercel too).
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_SHORTCODE=your-daraja-shortcode
DARAJA_PASSKEY=your-daraja-passkey
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_CALLBACK_BASE_URL=https://your-public-domain/api/payments/daraja/callback
DARAJA_CALLBACK_TOKEN=generate-a-random-token-of-at-least-32-characters
# Set this in Vercel to the admin subdomain hostname, without a scheme.
# ADMIN_HOSTNAME=admin.example.com
